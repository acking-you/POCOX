[Unit]
Description=POCOX hosted backend (account API + relay credential vending)
Documentation=https://github.com/acking-you/POCOX
# The backend mints credentials against the relay, so start after it when the
# relay is on this host.
After=network-online.target pb-mapper-server.service
Wants=network-online.target

[Service]
Type=simple
User=pcx
Group=pcx
# Secrets — POCOX_MSG_HEADER_KEY, POCOX_JWT_SECRET, POCOX_GITHUB_CLIENT_ID — live here
# (chmod 0600, owned by pcx). Non-secret settings go in backend.toml.
EnvironmentFile=/etc/pocox/backend.env
Environment=POCOX_BACKEND_CONFIG=/etc/pocox/backend.toml
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/pocox-backend
WorkingDirectory=/var/lib/pocox
Restart=on-failure
RestartSec=2
LimitNOFILE=65535

# Hardening.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pocox
# Only needed if http_listen binds a port < 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
